--cpu Cortex-M3
"buttom-6\startup_stm32f103xb.o"
"buttom-6\main.o"
"buttom-6\stm32f1xx_it.o"
"buttom-6\stm32f1xx_hal_msp.o"
"buttom-6\stm32f1xx_hal_gpio_ex.o"
"buttom-6\stm32f1xx_hal.o"
"buttom-6\stm32f1xx_hal_rcc.o"
"buttom-6\stm32f1xx_hal_rcc_ex.o"
"buttom-6\stm32f1xx_hal_gpio.o"
"buttom-6\stm32f1xx_hal_dma.o"
"buttom-6\stm32f1xx_hal_cortex.o"
"buttom-6\stm32f1xx_hal_pwr.o"
